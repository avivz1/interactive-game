{
  "name": "interactive-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/copy-mediapipe.mjs && vite",
    "dev:lan": "node scripts/copy-mediapipe.mjs && vite --host --mode lan",
    "build": "node scripts/copy-mediapipe.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p api/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@upstash/redis": "1.39.0",
    "lean-qr": "2.7.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
